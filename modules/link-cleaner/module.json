{
  "id": "link-cleaner",
  "name": "Link Cleaner",
  "version": "1.0.0",
  "privacy_class": "P0",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "<all_urls>"
  ],
  "cells": {
    "default": "all"
  },
  "stores": [
    "keep-list"
  ],
  "network": "none",
  "min_surface_level": "S1",
  "kill_switch": true,
  "tests": [
    "tests/modules/test_link_cleaner.py"
  ]
}
