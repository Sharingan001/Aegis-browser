{
  "schema": 1,
  "axis": "surface",
  "id": "S3",
  "name": "Strict",
  "extends": "S2",
  "controls": [
    {
      "id": "media.autoplay",
      "mechanism": "autoconfig",
      "set": {
        "media.autoplay.default": 5
      },
      "locked": true,
      "override_of": "S2",
      "override_reason": "Escalate autoplay block from audible-only (1) to all media (5)",
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_surface_levels.py"
      },
      "user_cost": "All media autoplay blocked"
    },
    {
      "id": "js.jit",
      "mechanism": "autoconfig",
      "set": {
        "javascript.options.baselinejit": false,
        "javascript.options.ion": false
      },
      "locked": true,
      "override_of": "S1",
      "override_reason": "Disable baseline JIT and IonMonkey compilers; force interpreter execution",
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_surface_levels.py"
      },
      "user_cost": "Slower script-heavy pages (interpreter execution)"
    },
    {
      "id": "js.wasm",
      "mechanism": "autoconfig",
      "set": {
        "javascript.options.wasm": false
      },
      "locked": true,
      "override_of": "S1",
      "override_reason": "Disable WebAssembly runtime",
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_surface_levels.py"
      },
      "user_cost": "WebAssembly applications fail to run"
    },
    {
      "id": "gfx.webgl",
      "mechanism": "autoconfig",
      "set": {
        "webgl.disabled": true
      },
      "locked": true,
      "override_of": "S1",
      "override_reason": "Disable WebGL 3D canvas contexts",
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_surface_levels.py"
      },
      "user_cost": "WebGL and 3D graphics disabled"
    },
    {
      "id": "doc.mathml",
      "mechanism": "autoconfig",
      "set": {
        "mathml.disabled": true
      },
      "locked": true,
      "override_of": "S1",
      "override_reason": "Disable MathML rendering engine",
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_surface_levels.py"
      },
      "user_cost": "Native MathML rendering disabled"
    },
    {
      "id": "gfx.font_svg",
      "mechanism": "autoconfig",
      "set": {
        "gfx.font_rendering.opentype_svg.enabled": false
      },
      "locked": true,
      "override_of": "S1",
      "override_reason": "Disable OpenType-SVG font rendering engine",
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_surface_levels.py"
      },
      "user_cost": "OpenType-SVG color fonts disabled"
    }
  ],
  "compat_notes": [
    "Maps, 3D graphics, and complex WebAssembly web applications will not function"
  ],
  "fingerprint_visible": true
}
