{
  "schema": 1,
  "axis": "identity",
  "id": "I1",
  "name": "Native",
  "extends": null,
  "controls": [
    {
      "id": "fp.protection",
      "mechanism": "autoconfig",
      "set": {
        "privacy.fingerprintingProtection": false
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "Native fingerprinting baseline exposed without perturbation"
    },
    {
      "id": "fp.protection.remote_overrides",
      "mechanism": "autoconfig",
      "set": {
        "privacy.fingerprintingProtection.remoteOverrides.enabled": false
      },
      "locked": true,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "Remote override telemetry disabled (Hard Rule 7, D-012)"
    },
    {
      "id": "fp.protection.overrides",
      "mechanism": "autoconfig",
      "set": {
        "privacy.fingerprintingProtection.overrides": ""
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "Default FPP target set"
    },
    {
      "id": "fp.resist_fingerprinting",
      "mechanism": "autoconfig",
      "set": {
        "privacy.resistFingerprinting": false
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "RFP uniform spoofing disabled"
    },
    {
      "id": "fp.letterboxing",
      "mechanism": "autoconfig",
      "set": {
        "privacy.resistFingerprinting.letterboxing": false
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "Letterboxing margins disabled"
    },
    {
      "id": "net.referer_trimming",
      "mechanism": "autoconfig",
      "set": {
        "network.http.referer.trimmingPolicy": 0
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "Default full URL referrer policy"
    },
    {
      "id": "webrtc.ice_no_host",
      "mechanism": "autoconfig",
      "set": {
        "media.peerconnection.ice.no_host": false
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py"
      },
      "user_cost": "WebRTC can query host candidate IPs"
    },
    {
      "id": "net.accept_language_native",
      "mechanism": "autoconfig",
      "set": {
        "intl.accept_languages": ""
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py",
        "method": "Confirm I1 does not set a static Accept-Language override"
      },
      "user_cost": "Accept-Language reflects system locale"
    },
    {
      "id": "net.remote_fonts_native",
      "mechanism": "autoconfig",
      "set": {
        "gfx.downloadable_fonts.enabled": true
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py",
        "method": "Verify pref is true in I1 baseline"
      },
      "user_cost": "Remote fonts enabled"
    },
    {
      "id": "net.referrer_xorigin_native",
      "mechanism": "autoconfig",
      "set": {
        "network.http.referer.XOriginPolicy": 0
      },
      "locked": false,
      "verify": {
        "type": "runtime-check",
        "test": "tests/axes/test_identity_levels.py",
        "method": "Verify pref is 0 in I1 baseline"
      },
      "user_cost": "Default cross-origin referrer policy"
    }
  ],
  "compat_notes": [
    "Native browser identity without fingerprint masking or noise",
    "dom.gamepad.enabled is not listed: with JavaScript disabled (S4), it is unreachable. For S1-S3 the Gamepad API behaves per browser default."
  ],
  "fingerprint_visible": false
}
